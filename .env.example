# Copie para .env.local (desenvolvimento) ou cadastre como variáveis no Railway.

# PostgreSQL. Local: npm run db:init (porta 5433). Railway: use a referência ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://postgres@localhost:5433/mastprod

# Assinatura do cookie de sessão (mínimo 32 caracteres). Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Chave AES-256 (32 bytes em Base64) que cifra os certificados A1 no banco.
# ATENÇÃO: trocar esta chave invalida os certificados já cadastrados.
ESOCIAL_CERT_ENCRYPTION_KEY=

# eSocial: producao | producaoRestrita
ESOCIAL_AMBIENTE=producaoRestrita
ESOCIAL_VER_PROC=1.0.0

# Usuário admin inicial (npm run db:create-user)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
